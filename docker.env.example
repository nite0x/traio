# Copy this file to .env next to compose.yaml. Do not commit the resulting .env.
TRAIO_IMAGE=traio-server:local

# Built-in login is the simplest server mode for one person. Change the
# password before first startup. It is used only to create the initial Owner;
# the database stores an Argon2id hash, never the plaintext password.
TRAIO_AUTH_MODE=password
TRAIO_BOOTSTRAP_ADMIN_USERNAME=owner
TRAIO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
TRAIO_BOOTSTRAP_ADMIN_EMAIL=
TRAIO_BOOTSTRAP_ADMIN_NAME=Owner
TRAIO_COOKIE_SECURE=false

# Set TRAIO_COOKIE_SECURE=true when the browser reaches Traio over HTTPS.
# After the first successful startup, the bootstrap username/password may be
# removed from .env. Alternatively use TRAIO_BOOTSTRAP_ADMIN_PASSWORD_FILE.
TRAIO_BOOTSTRAP_ADMIN_PASSWORD_FILE=

# Optional enterprise login: change TRAIO_AUTH_MODE to oidc and configure:
TRAIO_OIDC_ISSUER_URL=
TRAIO_OIDC_CLIENT_ID=
TRAIO_OIDC_CLIENT_SECRET=
TRAIO_OIDC_REDIRECT_URL=
TRAIO_SESSION_TTL=12h

# Leave these empty while accessing through an SSH tunnel. Set both when the
# API and IBKR login proxy have their own HTTPS hostnames.
TRAIO_ALLOWED_API_HOSTS=
TRAIO_IBKR_PROXY_URL=
